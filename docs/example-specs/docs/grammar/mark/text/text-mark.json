{
  "$schema": "https://genomespy.app/schema/core/v1.json",

  "description": "Text mark example.",

  "data": {
    "values": [
      { "x": 1, "text": "Hello" },
      { "x": 2, "text": "world!" }
    ]
  },

  "mark": "text",

  "encoding": {
    "x": { "field": "x", "type": "ordinal" },
    "color": { "field": "x", "type": "nominal", "legend": null },
    "text": { "field": "text" },
    "size": { "value": 100 }
  }
}
