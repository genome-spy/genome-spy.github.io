{
  "$schema": "https://genomespy.app/schema/core/v0.json",

  "description": "A grid view inside a scrollable viewport",

  "data": { "url": "data/sincos.csv" },

  "encoding": {
    "x": { "field": "x", "type": "quantitative" },
    "y": { "field": "sin", "type": "quantitative" }
  },

  "vconcat": [
    {
      "viewportHeight": 300,
      "vconcat": [
        {
          "height": 200,
          "mark": "point"
        },
        {
          "height": 200,
          "mark": "point"
        }
      ]
    },
    {
      "height": 200,
      "mark": "point"
    }
  ],

  "config": {
    "view": { "stroke": "lightgray" }
  }
}
